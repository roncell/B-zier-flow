{
  "name": "bezier-flow",
  "version": "2.0.0",
  "private": true,
  "description": "Interactive 3D cubic Bézier curve editor: chain segments, drag control points in 3D and animate an object along the path.",
  "keywords": ["threejs", "r3f", "bezier", "curves", "animation", "gsap"],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "build:portfolio": "vite build --outDir ../rohan-portfolio/bezier --emptyOutDir"
  },
  "dependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "gsap": "3.12.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
